pipeline {
    agent any

    stages {
        stage('Code Quality') {
            steps {
                echo 'Sonar Analysis Started'
                sh 'sudo docker run --rm -e SONAR_HOST_URL="http://13.201.13.14:9000" -v ".:/usr/src" sonarsource/sonar-scanner-cli -Dsonar.token=YOUR_SONAR_TOKEN -Dsonar.projectKey=ecomm'
                echo 'Sonar Analysis Completed'
            }
        }

        stage('Publish Ecom') {
            steps {
                sh "zip -r ecomm-${BUILD_NUMBER}.zip *.html style.css"
                sh "curl -v -u admin:nexus@1234 --upload-file ecomm-${BUILD_NUMBER}.zip http://13.201.13.14:8081/repository/ecomm/"
            }
        }

        stage('Deploy Ecom') {
            steps {
                sh "curl -u admin:nexus@1234 -X GET 'http://13.201.13.14:8081/repository/ecomm/ecomm-${BUILD_NUMBER}.zip' --output ecomm-${BUILD_NUMBER}.zip"
                sh 'sudo rm -rf /var/www/html/*'
                sh "sudo unzip -o ecomm-${BUILD_NUMBER}.zip -d /var/www/html"
            }
        }

        stage('Clean Up Workspace') {
            steps {
                echo 'Cleaning Work Space'
                cleanWs()
            }
        }
    }
}
